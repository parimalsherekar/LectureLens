# LLM Transcription Server — environment config
# Tuned for GTX 1650 (4 GB VRAM) with pip-installed CUDA packages
# Place this file next to server.js

# ── Whisper model ────────────────────────────────────────────────────────────
# small  = 244M params — good accuracy, fits easily in 4 GB VRAM (~1 GB used)
# medium = 769M params — better accuracy, still fits in 4 GB (~2.5 GB used)
# large-v2 = 1.5B params — best accuracy, tight on 4 GB (try if small isn't enough)
WHISPER_MODEL=small

# ── Device ───────────────────────────────────────────────────────────────────
# cuda  = GPU inference via pip-installed nvidia-cublas-cu12 / nvidia-cudnn-cu12
# cpu   = fallback if CUDA still fails after this fix
WHISPER_DEVICE=cuda

# ── Compute type ─────────────────────────────────────────────────────────────
# float16 = native half-precision for GTX 1650 (fastest + good accuracy on GPU)
# int8    = quantised (use this if you see VRAM OOM errors on 4 GB)
WHISPER_COMPUTE=float16

# ── Beam search ──────────────────────────────────────────────────────────────
# Higher beam = more accurate but slower per chunk
# 5 is a good balance; use 1 if latency matters more than accuracy
WHISPER_BEAM=5

# ── Language ─────────────────────────────────────────────────────────────────
WHISPER_LANG=en

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:3000